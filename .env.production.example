# ═══════════════════════════════════════════════════════════════════
# PAZARIO - PRODUCTION ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════
# Copy to .env.production and fill in actual values

# ── DATABASE ──────────────────────────────────────────────
DB_USER=pazario
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=pazario_prod
# Full PostgreSQL URL: postgresql://user:password@host:5432/database
DATABASE_URL="postgresql://pazario:CHANGE_ME_STRONG_PASSWORD@postgres:5432/pazario_prod"

# ── REDIS ─────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# Full Redis URL: redis://:password@host:6379
REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379"

# ── APPLICATION ───────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
DEFAULT_DESI=1

# ── SECURITY (FROM GITHUB SECRETS) ────────────────────────
JWT_SECRET=CHANGE_ME_MIN_32_CHARACTERS_LONG_SECRET_KEY_HERE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FIELD_ENCRYPTION_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS="https://app.example.com,https://www.example.com"

# ── MARKETPLACE API KEYS (FROM GITHUB SECRETS) ───────────
# Trendyol
TY_API_KEY=
TY_API_SECRET=
TY_SUPPLIER_ID=

# N11
N11_APPKEY=
N11_APPSECRET=
N11_INTEGRATOR=PazarioIntegration

# Hepsiburada
HB_MERCHANT_ID=
HB_SERVICE_KEY=

# Pazarama
PZ_CLIENT_ID=
PZ_CLIENT_SECRET=

# ── CARGO API KEYS (FROM GITHUB SECRETS) ─────────────────
ARAS_API_KEY=
YURTICI_API_KEY=
SURAT_API_KEY=
PTT_API_KEY=

# ── AI/LLM (FROM GITHUB SECRETS) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-
GEMINI_API_KEY=

# ── NOTIFICATIONS ────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── BACKUP & MONITORING ──────────────────────────────────
BACKUP_SCHEDULE="0 2 * * *"  # 2 AM daily
BACKUP_RETENTION_DAYS=30
MONITORING_ENABLED=true
