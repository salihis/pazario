# Auto detect text files and normalize line endings to LF
* text=auto

# Code files
*.js eol=lf
*.ts eol=lf
*.tsx eol=lf
*.jsx eol=lf
*.json eol=lf
*.yaml eol=lf
*.yml eol=lf
*.md eol=lf
*.sql eol=lf
*.sh eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.svg binary

# Docker files
Dockerfile eol=lf
docker-compose.yml eol=lf
docker-compose.prod.yml eol=lf
