# === Pazar.io Backend environment variables ===
# Copy this file to .env for local development.

# Database
DATABASE_URL="postgresql://pazario:password@localhost:5432/pazario_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="buraya-guclu-bir-secret-yaz-min-32-karakter"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Field encryption for customer/order data. Must be 64 hex chars.
FIELD_ENCRYPTION_KEY="64-karakter-hex-aes-256-anahtari"

# AI
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY=""
GEMINI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta/models/"
ANTHROPIC_MODEL_VERSION="claude-3-sonnet"

# Trendyol
TY_API_KEY="..."
TY_API_SECRET="..."
TY_SUPPLIER_ID="..."
TY_BRAND_ID="..."
TY_CARGO_COMPANY_ID="..."
TY_DIMENSIONAL_WEIGHT="1"
TY_VAT_RATE="20"

# Hepsiburada
HB_MERCHANT_ID="uuid-formatinda-merchant-id"
HB_SERVICE_KEY="12karakterservisanahtar"

# N11
N11_APPKEY="..."
N11_APPSECRET="..."
N11_ORDERS_URL="https://api.n11.com/rest/delivery/v1/shipmentPackages"
N11_INTEGRATOR="PazarioEntegrasyon"
N11_PREPARING_DAY="3"
N11_SHIPMENT_TEMPLATE="1"
N11_VAT_RATE="20"

# Pazarama
PZ_CLIENT_ID="..."
PZ_CLIENT_SECRET="..."
PZ_ORDERS_URL="https://isortagimapi.pazarama.com/order/getOrdersForApi"
PZ_BRAND_ID="..."
PZ_PRODUCT_CREATE_PATH="/web/products"
PZ_VAT_RATE="20"

# SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cargo
ARAS_API_KEY="..."
YURTICI_API_KEY="..."
SURAT_API_KEY="..."
PTT_API_KEY="..."

# App
PORT=3000
MAKE_SOCIAL_WEBHOOK_URL=""
NODE_ENV="development"
LOG_LEVEL="info"
DEFAULT_DESI=1
ALLOWED_ORIGINS="http://localhost:5174,http://localhost:3456,http://127.0.0.1:5174"

# Notifications
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
ORDER_NOTIFICATION_EMAIL=
