# === Pazar.io Backend — Ortam Değişkenleri ===
# Bu dosyayı .env olarak kopyala: cp .env.example .env

# ── Veritabanı ────────────────────────────────
DATABASE_URL="postgresql://pazario:password@localhost:5432/pazario_db"

# ── Redis ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────
JWT_SECRET="buraya-guclu-bir-secret-yaz-min-32-karakter"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Şifreleme (KVKK — müşteri verisi) ─────────
FIELD_ENCRYPTION_KEY="32-karakter-hex-aes-256-anahtari"

# ── Anthropic (Kategori AI) ───────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Trendyol ──────────────────────────────────
TY_API_KEY="..."
TY_API_SECRET="..."
TY_SUPPLIER_ID="..."

# ── Hepsiburada (Ağustos 2024+ yeni yapı) ─────
HB_MERCHANT_ID="uuid-formatinda-merchant-id"
HB_SERVICE_KEY="12karakterservisanahtar"

# ── N11 (REST API — SOAP değil) ───────────────
N11_APPKEY="..."
N11_APPSECRET="..."
N11_INTEGRATOR="PazarioEntegrasyon"

# ── Pazarama ──────────────────────────────────
PZ_CLIENT_ID="..."
PZ_CLIENT_SECRET="..."

# ── Kargo ─────────────────────────────────────
ARAS_API_KEY="..."
YURTICI_API_KEY="..."
SURAT_API_KEY="..."
PTT_API_KEY="..."

# ── Uygulama ──────────────────────────────────
PORT=3000
NODE_ENV="development"
LOG_LEVEL="info"
DEFAULT_DESI=1

# ── CORS (Production'da belirli domain'lere kısıtla) ──
ALLOWED_ORIGINS="http://localhost:5174,http://localhost:3456,http://127.0.0.1:5174"

# ── AI & LLM (Kategori Eşleştirmesi) ──────────
GEMINI_API_KEY=""
GEMINI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta/models/"
ANTHROPIC_MODEL_VERSION="claude-3-sonnet"

# ── Bildirim ──────────────────────────────────
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
