/// Pazaryeri kategori Ã¶zellik Ã¶nbelleÄŸi
model MarketplaceCategoryAttribute {
  id               String        @id @default(uuid()) @db.Uuid
  marketplace      Marketplace
  categoryId       String        @db.VarChar(100)
  attributeId      String        @db.VarChar(100)
  attributeName    String        @db.VarChar(200)
  attributeType    AttributeType
  isMandatory      Boolean       @default(false)
  allowCustomValue Boolean       @default(false)
  values           Json?
  validationRules  Json?
  displayOrder     Int           @default(0)
  fetchedAt        DateTime      @default(now()) @db.Timestamptz

  @@unique([marketplace, categoryId, attributeId])
  @@index([marketplace, categoryId, isMandatory])
  @@map("marketplace_category_attributes")
}

/// ÃœrÃ¼n Ã¶zellik deÄŸerleri
model ProductAttribute {
  id            String      @id @default(uuid()) @db.Uuid
  productId     String      @db.Uuid
  product       Product     @relation(fields: [productId], references: [id])
  marketplace   Marketplace
  attributeId   String      @db.VarChar(100)
  attributeName String?     @db.VarChar(200)
  valueId       String?     @db.VarChar(100)
  valueText     String?     @db.Text
  isInherited   Boolean     @default(false)
  savedBy       String?     @db.VarChar(100)
  savedAt       DateTime    @default(now()) @db.Timestamptz

  @@unique([productId, marketplace, attributeId])
  @@index([productId, marketplace])
  @@map("product_attributes")
}

/// Reusable defaults and conditional rules for marketplace category attributes.
model AttributeRule {
  id                    String                 @id @default(uuid()) @db.Uuid
  marketplace           Marketplace
  sourceId              String?                @db.Uuid
  source                XmlSource?             @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceCategory        String?                @db.Text
  marketplaceCategoryId String?                @db.VarChar(100)
  name                  String                 @db.VarChar(200)
  attributeId           String                 @db.VarChar(100)
  attributeName         String?                @db.VarChar(200)
  valueId               String?                @db.VarChar(100)
  valueText             String?                @db.Text
  matchType             AttributeRuleMatchType @default(ALWAYS)
  matchField            String?                @db.VarChar(200)
  matchValue            String?                @db.Text
  confidence            Decimal                @default(1) @db.Decimal(4, 3)
  priority              Int                    @default(100)
  isActive              Boolean                @default(true)
  createdBy             String?                @db.VarChar(100)
  createdAt             DateTime               @default(now()) @db.Timestamptz
  updatedAt             DateTime               @updatedAt @db.Timestamptz

  @@index([marketplace, sourceId, sourceCategory])
  @@index([marketplace, marketplaceCategoryId, isActive])
  @@index([attributeId, isActive])
  @@map("attribute_rules")
}

/// ÃœrÃ¼n gÃ¶nderim iÅŸ takibi
model ProductPublishJob {
  id            String        @id @default(uuid()) @db.Uuid
  productId     String        @db.Uuid
  product       Product       @relation(fields: [productId], references: [id])
  marketplace   Marketplace
  externalJobId String?       @db.VarChar(200)
  status        PublishStatus @default(QUEUED)
  attemptCount  Int           @default(0)
  lastPolledAt  DateTime?     @db.Timestamptz
  errorMessage  String?       @db.Text
  submittedAt   DateTime?     @db.Timestamptz
  resolvedAt    DateTime?     @db.Timestamptz
  triggeredBy   String?       @db.VarChar(100)
  createdAt     DateTime      @default(now()) @db.Timestamptz

  @@index([status, marketplace, lastPolledAt])
  @@index([productId, marketplace])
  @@map("product_publish_jobs")
}

model OperationHistory {
  id                  String          @id @default(uuid()) @db.Uuid
  type                OperationType
  status              OperationStatus @default(QUEUED)
  title               String          @db.VarChar(250)
  marketplace         Marketplace?
  queueName           String?         @db.VarChar(100)
  queueJobId          String?         @db.VarChar(100)
  externalBatchId     String?         @db.VarChar(250)
  requestedBy         String?         @db.VarChar(100)
  sourceId            String?         @db.Uuid
  syncJobId           String?         @db.Uuid
  productPublishJobId String?         @db.Uuid
  targetCount         Int             @default(0)
  successCount        Int             @default(0)
  failedCount         Int             @default(0)
  skippedCount        Int             @default(0)
  retryCount          Int             @default(0)
  maxRetryCount       Int             @default(3)
  errorMessage        String?         @db.Text
  metadata            Json            @default("{}")
  retryPayload        Json?
  startedAt           DateTime?       @db.Timestamptz
  finishedAt          DateTime?       @db.Timestamptz
  createdAt           DateTime        @default(now()) @db.Timestamptz
  updatedAt           DateTime        @updatedAt @db.Timestamptz
  items               OperationItem[]

  @@index([status, type, createdAt])
  @@index([marketplace, status])
  @@index([queueName, queueJobId])
  @@map("operation_history")
}

model OperationItem {
  id                String              @id @default(uuid()) @db.Uuid
  operationId       String              @db.Uuid
  operation         OperationHistory    @relation(fields: [operationId], references: [id], onDelete: Cascade)
  productId         String?             @db.Uuid
  product           Product?            @relation(fields: [productId], references: [id])
  sku               String?             @db.VarChar(150)
  barcode           String?             @db.VarChar(150)
  variantGroupKey   String?             @db.VarChar(250)
  status            OperationItemStatus @default(QUEUED)
  externalListingId String?             @db.VarChar(250)
  externalBatchId   String?             @db.VarChar(250)
  errorMessage      String?             @db.Text
  metadata          Json                @default("{}")
  startedAt         DateTime?           @db.Timestamptz
  finishedAt        DateTime?           @db.Timestamptz
  createdAt         DateTime            @default(now()) @db.Timestamptz
  updatedAt         DateTime            @updatedAt @db.Timestamptz

  @@index([operationId, status])
  @@index([productId])
  @@index([sku])
  @@map("operation_items")
}
