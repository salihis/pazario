// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// â”€â”€â”€ ENUM'LAR â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum SyncJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED

  @@map("sync_job_status")
}

enum Marketplace {
  TRENDYOL
  HEPSIBURADA
  N11
  PAZARAMA

  @@map("marketplace")
}

enum ListingStatus {
  PENDING
  PUBLISHED
  FAILED
  DELISTED

  @@map("listing_status")
}

enum ErrorType {
  VALIDATION
  API
  NETWORK
  MAPPING

  @@map("error_type")
}

enum AttributeRuleMatchType {
  ALWAYS
  TITLE_CONTAINS
  BRAND_EQUALS
  XML_ATTRIBUTE_EQUALS

  @@map("attribute_rule_match_type")
}

enum OperationType {
  PRODUCT_PUBLISH
  VARIANT_UPDATE
  STOCK_UPDATE
  PRICE_UPDATE
  STOCK_PRICE_UPDATE
  XML_SYNC
  ORDER_FETCH
  MARKETPLACE_IMPORT

  @@map("operation_type")
}

enum OperationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  PARTIALLY_FAILED
  WAITING_MARKETPLACE
  RETRYING

  @@map("operation_status")
}

enum OperationItemStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED

  @@map("operation_item_status")
}

// â”€â”€â”€ TABLOLAR â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// XML kaynak tanÄ±mlarÄ± â€” tedarikÃ§i feed URL'leri
model XmlSource {
  id                      String    @id @default(uuid()) @db.Uuid
  name                    String    @db.VarChar(100)
  url                     String
  fallbackUrl             String?   @map("fallback_url")
  fetchTimeoutSec         Int       @default(60)
  categoryIncludeKeywords String?   @map("categoryincludekeywords") @db.VarChar(500)
  priceIncludesVat        Boolean   @default(true)
  purchaseVatRate         Decimal   @default(0) @db.Decimal(5, 2)
  purchaseExtraFee        Decimal   @default(0) @db.Decimal(12, 2)
  autoSyncEnabled         Boolean   @default(true)
  autoSyncTime            String    @default("03:00") @db.VarChar(5)
  lastAutoSyncAt          DateTime? @db.Timestamptz
  active                  Boolean   @default(true)
  createdAt               DateTime  @default(now()) @db.Timestamptz

  // Ä°liÅŸkiler
  syncJobs         SyncJob[]
  products         Product[]
  categoryMappings CategoryMapping[]
  attributeRules   AttributeRule[]
  orderItems       OrderItem[]

  @@map("xml_sources")
}

/// Senkronizasyon iÅŸleri â€” her XML Ã§ekme iÅŸlemi bir job'dÄ±r
model SyncJob {
  id              String        @id @default(uuid()) @db.Uuid
  sourceId        String        @db.Uuid
  source          XmlSource     @relation(fields: [sourceId], references: [id])
  status          SyncJobStatus @default(PENDING)
  totalProducts   Int?
  changedProducts Int?
  publishedCount  Int?
  failedCount     Int?
  errorMessage    String?       @db.Text
  startedAt       DateTime?     @db.Timestamptz
  finishedAt      DateTime?     @db.Timestamptz
  createdAt       DateTime      @default(now()) @db.Timestamptz

  // Ä°liÅŸkiler
  listings          MarketplaceListing[]
  publishErrors     PublishError[]
  priceCalculations PriceCalculation[]

  @@map("sync_jobs")
}

/// ÃœrÃ¼n kataloÄŸu â€” tedarikÃ§iden gelen normalize edilmiÅŸ Ã¼rÃ¼nler
model Product {
  id          String    @id @default(uuid()) @db.Uuid
  sourceId    String    @db.Uuid
  source      XmlSource @relation(fields: [sourceId], references: [id])
  externalId  String    @db.VarChar(100)
  sku         String    @db.VarChar(100)
  barcode     String?   @db.VarChar(20)
  title       String    @db.VarChar(500)
  description String?   @db.Text
  brand       String?   @db.VarChar(100)
  categoryRaw String?   @db.VarChar(500)
  price       Decimal   @db.Decimal(12, 2)
  listPrice   Decimal?  @db.Decimal(12, 2)
  currency    String    @default("TRY") @db.VarChar(3)
  stock       Int       @default(0)
  images      String[]
  manualMedia Json?
  mediaVersion Int @default(0)
  attributes  Json      @default("{}")
  contentHash String    @db.Char(32)
  lastSeenAt  DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  // Ä°liÅŸkiler
  listings          MarketplaceListing[]
  publishErrors     PublishError[]
  productAttributes ProductAttribute[]
  publishJobs       ProductPublishJob[]
  operationItems    OperationItem[]
  priceCalculations PriceCalculation[]

  @@unique([sourceId, externalId])
  @@index([contentHash])
  @@index([barcode])
  @@map("products")
}

/// Pazaryeri yayÄ±n durumlarÄ± â€” her Ã¼rÃ¼nÃ¼n her pazaryerindeki durumu
model LocalSyncState {
  id              String    @id @default("default")
  lastSeenAt      DateTime? @db.Timestamptz
  lastSyncAt      DateTime? @db.Timestamptz
  totalProducts   Int       @default(0)
  pendingProducts Int       @default(0)
  syncedProducts  Int       @default(0)
  failedProducts  Int       @default(0)
  lastError       String?   @db.Text
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  @@map("local_sync_state")
}

model MarketplaceListing {
  id                String        @id @default(uuid()) @db.Uuid
  productId         String        @db.Uuid
  product           Product       @relation(fields: [productId], references: [id])
  marketplace       Marketplace
  status            ListingStatus @default(PENDING)
  externalListingId String?       @db.VarChar(200)
  lastSyncJobId     String?       @db.Uuid
  lastSyncJob       SyncJob?      @relation(fields: [lastSyncJobId], references: [id])
  publishedAt       DateTime?     @db.Timestamptz
  lastUpdatedAt     DateTime?     @db.Timestamptz
  hashAtPublish     String?       @db.Char(32)

  @@unique([productId, marketplace])
  @@index([status, marketplace])
  @@map("marketplace_listings")
}

/// Hata kayÄ±tlarÄ± â€” yayÄ±n sÄ±rasÄ±nda oluÅŸan hatalar
/// Pazaryerinden okunan ham ürün listesi. Pazaryerleri ekranı yerel Product tablosunu değil bu tabloyu gösterir.
model MarketplaceExternalProduct {
  id                String        @id @default(uuid()) @db.Uuid
  marketplace       Marketplace
  listingKey        String        @db.VarChar(200)
  externalListingId String?       @db.VarChar(200)
  stockCode         String?       @db.VarChar(200)
  barcode           String?       @db.VarChar(200)
  title             String        @db.VarChar(700)
  brand             String?       @db.VarChar(200)
  categoryName      String?       @db.VarChar(700)
  imageUrl          String?
  price             Decimal?      @db.Decimal(12, 2)
  stock             Int?
  status            ListingStatus @default(PUBLISHED)
  raw               Json          @default("{}")
  firstSeenAt       DateTime      @default(now()) @db.Timestamptz
  lastSeenAt        DateTime      @default(now()) @db.Timestamptz

  @@unique([marketplace, listingKey])
  @@index([marketplace, status])
  @@index([stockCode])
  @@index([barcode])
  @@map("marketplace_external_products")
}

model PublishError {
  id           String    @id @default(uuid()) @db.Uuid
  jobId        String    @db.Uuid
  job          SyncJob   @relation(fields: [jobId], references: [id])
  productId    String    @db.Uuid
  product      Product   @relation(fields: [productId], references: [id])
  marketplace  String    @db.VarChar(50)
  errorType    ErrorType
  errorCode    String?   @db.VarChar(50)
  errorMessage String    @db.Text
  retryCount   Int       @default(0)
  resolved     Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.Timestamptz

  @@index([resolved, marketplace])
  @@map("publish_errors")
}

// â”€â”€â”€ FÄ°YAT KURALLARI â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum PriceRuleScope {
  GLOBAL
  MARKETPLACE
  CATEGORY
  BRAND
  PRODUCT

  @@map("price_rule_scope")
}

enum CategoryMappingStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("category_mapping_status")
}

/// Fiyat kurallarÄ± â€” pazaryeri bazlÄ± kar/komisyon hesaplama
model PriceRule {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(150)
  marketplace   String         @db.VarChar(50)
  scopeType     PriceRuleScope
  scopeValue    String?        @db.VarChar(500)
  priceStart    Decimal?       @db.Decimal(12, 2)
  priceEnd      Decimal?       @db.Decimal(12, 2)
  ekTutar       Decimal        @default(0) @db.Decimal(10, 2)
  karOrani      Decimal        @default(1.0) @db.Decimal(6, 4)
  kargo         Decimal        @default(0) @db.Decimal(10, 2)
  komisyonOrani Decimal        @db.Decimal(5, 4)
  priority      Int
  active        Boolean        @default(true)
  createdBy     String?        @db.VarChar(100)
  createdAt     DateTime       @default(now()) @db.Timestamptz
  updatedAt     DateTime       @updatedAt @db.Timestamptz

  // Ä°liÅŸkiler
  calculations PriceCalculation[]

  @@index([marketplace, scopeType, active])
  @@map("price_rules")
}

/// Fiyat hesaplama audit log â€” her hesaplama adÄ±m adÄ±m kaydedilir
model PriceCalculation {
  id              String    @id @default(uuid()) @db.Uuid
  productId       String    @db.Uuid
  product         Product   @relation(fields: [productId], references: [id])
  marketplace     String    @db.VarChar(50)
  ruleId          String    @db.Uuid
  rule            PriceRule @relation(fields: [ruleId], references: [id])
  syncJobId       String    @db.Uuid
  syncJob         SyncJob   @relation(fields: [syncJobId], references: [id])
  basePrice       Decimal   @db.Decimal(12, 2)
  ekTutar         Decimal   @db.Decimal(10, 2)
  karOrani        Decimal   @db.Decimal(6, 4)
  kargo           Decimal   @db.Decimal(10, 2)
  komisyonOrani   Decimal   @db.Decimal(5, 4)
  ara1BaseEk      Decimal   @db.Decimal(12, 2)
  ara2Kar         Decimal   @db.Decimal(12, 2)
  ara3Kargo       Decimal   @db.Decimal(12, 2)
  rawPrice        Decimal   @db.Decimal(12, 2)
  minPriceApplied Boolean   @default(false)
  finalPrice      Decimal   @db.Decimal(12, 2)
  calculatedAt    DateTime  @default(now()) @db.Timestamptz

  @@index([productId, marketplace, calculatedAt(sort: Desc)])
  @@map("price_calculations")
}

/// Global minimum fiyat ayarÄ± â€” singleton tablo
model GlobalPriceSetting {
  id        String   @id @default(uuid()) @db.Uuid
  minPrice  Decimal  @db.Decimal(12, 2)
  currency  String   @default("TRY") @db.VarChar(3)
  updatedBy String?  @db.VarChar(100)
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("global_price_settings")
}

/// Pazaryeri stok/fiyat otomatik guncelleme ayarlari
model MarketplaceSyncSetting {
  id             String      @id @default(uuid()) @db.Uuid
  marketplace    Marketplace @unique
  enabled        Boolean     @default(false)
  mode           String      @default("stock-price") @db.VarChar(20)
  scheduleTime   String      @default("03:00") @db.VarChar(5)
  limit          Int         @default(1000)
  lastRunAt      DateTime?   @db.Timestamptz
  batchStartedAt DateTime?   @db.Timestamptz
  batchNextRunAt DateTime?   @db.Timestamptz
  updatedAt      DateTime    @updatedAt @db.Timestamptz

  @@map("marketplace_sync_settings")
}

model MarketplaceCredential {
  id                   String      @id @default(uuid()) @db.Uuid
  marketplace          Marketplace @unique
  name                 String      @db.VarChar(100)
  credentialsEncrypted String      @map("credentials_encrypted") @db.Text
  isActive             Boolean     @default(false) @map("is_active")
  lastTestStatus       String?     @map("last_test_status") @db.VarChar(20)
  lastTestMessage      String?     @map("last_test_message") @db.Text
  lastTestAt           DateTime?   @map("last_test_at") @db.Timestamptz
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@index([marketplace, isActive])
  @@map("marketplace_credentials")
}

/// Kategori eÅŸleÅŸtirme â€” tedarikÃ§i kategorisini pazaryeri kategorisine baÄŸlar
model CategoryMapping {
  id                      String                @id @default(uuid()) @db.Uuid
  sourceId                String                @db.Uuid
  source                  XmlSource             @relation(fields: [sourceId], references: [id])
  sourceCategory          String                @db.Text
  marketplace             Marketplace
  marketplaceCategoryId   String?               @db.VarChar(100)
  marketplaceCategoryPath String?               @db.Text
  status                  CategoryMappingStatus @default(PENDING)
  aiSuggested             Boolean               @default(false)
  aiConfidence            Decimal?              @db.Decimal(4, 3)
  aiReason                String?               @db.Text
  allSuggestions          Json?
  approvedBy              String?               @db.VarChar(100)
  approvedAt              DateTime?             @db.Timestamptz
  createdAt               DateTime              @default(now()) @db.Timestamptz
  updatedAt               DateTime              @updatedAt @db.Timestamptz

  @@unique([sourceId, sourceCategory, marketplace])
  @@index([marketplace, status])
  @@map("category_mappings")
}

/// Pazaryeri kategori aÄŸacÄ± Ã¶nbelleÄŸi
model MarketplaceCategory {
  id           String      @id @default(uuid()) @db.Uuid
  marketplace  Marketplace
  categoryId   String      @db.VarChar(100)
  categoryPath String      @db.Text
  categoryName String      @db.VarChar(500)
  parentId     String?     @db.VarChar(100)
  isLeaf       Boolean     @default(true)
  fetchedAt    DateTime    @db.Timestamptz

  @@unique([marketplace, categoryId])
  @@map("marketplace_categories")
}

// â”€â”€â”€ SÄ°PARÄ°Å ENUM'LARI â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum OrderStatus {
  NEW
  PENDING_APPROVAL
  PREPARING
  LABEL_CREATED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  DELIVERY_FAILED
  CANCELLATION_REQUESTED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  REFUNDED

  @@map("order_status")
}

enum InvoiceType {
  INVOICE
  CREDIT_NOTE

  @@map("invoice_type")
}

enum InvoiceStatus {
  DRAFT
  GENERATED
  APPROVED
  SENT
  FAILED

  @@map("invoice_status")
}

enum CargoCompany {
  ARAS
  YURTICI
  SURAT
  PTT

  @@map("cargo_company")
}

// â”€â”€â”€ SÄ°PARÄ°Å TABLOLARI â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// SipariÅŸler â€” tÃ¼m pazaryerlerinden Ã§ekilen sipariÅŸler
model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  marketplace        Marketplace
  marketplaceOrderId String      @unique @db.VarChar(100)
  marketplaceOrderNo String?     @db.VarChar(100)
  status             OrderStatus @default(NEW)
  /// AES-256-GCM ÅŸifreli â€” KVKK
  customerName       String?     @db.VarChar(200)
  /// AES-256-GCM ÅŸifreli â€” KVKK
  customerPhone      String?     @db.VarChar(20)
  /// AES-256-GCM ÅŸifreli â€” KVKK
  shippingAddress    Json?
  /// AES-256-GCM ÅŸifreli â€” KVKK
  billingAddress     Json?
  totalAmount        Decimal     @db.Decimal(12, 2)
  currency           String      @default("TRY") @db.VarChar(3)
  cargoCompany       String?     @db.VarChar(50)
  trackingNumber     String?     @db.VarChar(100)
  cargoLabelUrl      String?     @db.Text
  invoiceId          String?     @db.Uuid
  approvedBy         String?     @db.VarChar(100)
  approvedAt         DateTime?   @db.Timestamptz
  orderedAt          DateTime?   @db.Timestamptz
  fetchedAt          DateTime    @db.Timestamptz
  createdAt          DateTime    @default(now()) @db.Timestamptz
  updatedAt          DateTime    @updatedAt @db.Timestamptz

  // Ä°liÅŸkiler
  items      OrderItem[]
  statusLogs OrderStatusLog[]
  invoice    Invoice?
  shipment   Shipment?

  @@index([status, marketplace])
  @@index([status, orderedAt])
  @@map("orders")
}

/// SipariÅŸ kalemleri
model MarketplaceFinanceSnapshot {
  id           String      @id @default(uuid()) @db.Uuid
  marketplace  Marketplace
  environment  String      @db.VarChar(20)
  merchantId   String      @db.VarChar(100)
  orderNumber  String      @db.VarChar(100)
  transactions Json
  syncedAt     DateTime?    @db.Timestamptz
  lastError    String?      @db.VarChar(500)
  updatedAt    DateTime     @updatedAt @db.Timestamptz

  @@unique([marketplace, environment, merchantId, orderNumber], map: "marketplace_finance_snapshots_scope_key")
  @@map("marketplace_finance_snapshots")
}

model OrderItem {
  id                   String     @id @default(uuid()) @db.Uuid
  orderId              String     @db.Uuid
  order                Order      @relation(fields: [orderId], references: [id])
  productId            String?    @db.Uuid
  sourceId             String?    @db.Uuid
  source               XmlSource? @relation(fields: [sourceId], references: [id])
  marketplaceProductId String?    @db.VarChar(100)
  sku                  String?    @db.VarChar(100)
  title                String     @db.VarChar(500)
  quantity             Int
  unitPrice            Decimal    @db.Decimal(12, 2)
  totalPrice           Decimal    @db.Decimal(12, 2)
  discountAmount       Decimal    @default(0) @db.Decimal(12, 2)
  shippingFee          Decimal    @default(0) @db.Decimal(12, 2)
  serviceFee           Decimal    @default(0) @db.Decimal(12, 2)
  extraFees            Decimal    @default(0) @db.Decimal(12, 2)
  manualPurchasePrice  Decimal?   @db.Decimal(12, 2)
  vatRate              Int?

  @@index([sourceId])
  @@index([productId])
  @@map("order_items")
}

/// SipariÅŸ durum geÃ§iÅŸ loglarÄ±
model OrderStatusLog {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  order      Order    @relation(fields: [orderId], references: [id])
  fromStatus String?  @db.VarChar(50)
  toStatus   String   @db.VarChar(50)
  changedBy  String?  @db.VarChar(100)
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@map("order_status_logs")
}

/// Faturalar
model Invoice {
  id                String      @id @default(uuid()) @db.Uuid
  orderId           String      @unique @db.Uuid
  order             Order       @relation(fields: [orderId], references: [id])
  invoiceType       InvoiceType
  status            InvoiceStatus @default(DRAFT)
  invoiceNumber     String?     @db.VarChar(100)
  ettn              String?     @db.VarChar(100)
  scenario          String      @default("EARSIVFATURA") @db.VarChar(30)
  externalInvoiceId String?     @db.VarChar(100)
  pdfUrl            String?     @db.Text
  approvedFilePath  String?     @db.Text
  approvedFileName  String?     @db.VarChar(255)
  approvedFileSize  Int?
  publicToken       String?     @unique @db.VarChar(100)
  marketplaceStatus String?     @db.VarChar(50)
  marketplaceMessage String?    @db.Text
  marketplaceSentAt DateTime?   @db.Timestamptz
  totalAmount       Decimal     @db.Decimal(12, 2)
  issuedAt          DateTime?   @db.Timestamptz
  createdAt         DateTime    @default(now()) @db.Timestamptz
  updatedAt         DateTime    @updatedAt @db.Timestamptz

  @@map("invoices")
}

model InvoiceProfile {
  id             String   @id @default("default") @db.VarChar(50)
  companyName    String   @default("") @db.VarChar(200)
  address        String   @default("") @db.Text
  phone          String?  @db.VarChar(50)
  fax            String?  @db.VarChar(50)
  website        String?  @db.VarChar(255)
  email          String?  @db.VarChar(255)
  taxOffice      String?  @db.VarChar(150)
  taxNumber      String?  @db.VarChar(20)
  defaultVatRate Int      @default(20)
  invoicePrefix  String   @default("GIB") @db.VarChar(3)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  @@map("invoice_profiles")
}

// â”€â”€â”€ KARGO TABLOLARI â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Kargo gÃ¶nderileri
model Shipment {
  id                    String       @id @default(uuid()) @db.Uuid
  orderId               String       @unique @db.Uuid
  order                 Order        @relation(fields: [orderId], references: [id])
  cargoCompany          CargoCompany
  trackingNumber        String       @db.VarChar(100)
  labelPdfUrl           String?      @db.Text
  desi                  Decimal?     @db.Decimal(6, 2)
  weightKg              Decimal?     @db.Decimal(6, 3)
  status                String       @default("CREATED") @db.VarChar(50)
  rawStatus             String?      @db.VarChar(100)
  statusDescription     String?      @db.Text
  lastLocation          String?      @db.VarChar(200)
  estimatedDelivery     DateTime?    @db.Timestamptz
  deliveredAt           DateTime?    @db.Timestamptz
  lastCheckedAt         DateTime?    @db.Timestamptz
  marketplaceNotifiedAt DateTime?    @db.Timestamptz
  createdAt             DateTime     @default(now()) @db.Timestamptz

  @@map("shipments")
}

